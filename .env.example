# Required

# PostgreSQL connection string used by Prisma (prisma/schema.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authorization header value for the Bitpart WebSocket connection
BITPART_SERVER_TOKEN=replace-with-bitpart-server-token

# Comma-separated list of Bitpart server hosts (bots are round-robin assigned)
BITPART_SERVER_HOSTS=host1,host2

# Host of the EMS service, used to build EMS endpoint URLs
EMS_SERVER_HOST=ems.example.com

# NextAuth v5 JWT signing secret
AUTH_SECRET=replace-with-a-secure-random-string

# Optional

# Toggle NextAuth debug logging (set to any truthy value to enable)
AUTH_DEBUG=
