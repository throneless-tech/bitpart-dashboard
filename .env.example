# Required

# PostgreSQL connection string used by Prisma (prisma/schema.prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authorization header value for the Bitpart WebSocket connection
BITPART_SERVER_TOKEN=replace-with-bitpart-server-token

# Comma-separated list of Bitpart server hosts (bots are round-robin assigned)
BITPART_SERVER_HOSTS=host1,host2

# Host of the EMS service, used to build EMS endpoint URLs
EMS_SERVER_HOST=ems.example.com

# NextAuth v5 JWT signing secret
AUTH_SECRET=replace-with-a-secure-random-string

# Public base URL of this dashboard, used for links in emails
APP_URL=https://dashboard.example.com

# Outgoing email (password reset and email confirmation), via SMTP or SMTPS
SMTP_HOST=smtp.example.com
# 587 for STARTTLS, 465 for SMTPS
SMTP_PORT=587
# true for SMTPS (implicit TLS); defaults to true on port 465, otherwise STARTTLS
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# From address for emails sent by the dashboard
MAIL_FROM=no-reply@bitp.art

# Optional

# Toggle NextAuth debug logging (set to any truthy value to enable)
AUTH_DEBUG=

# Sign-up rate limit: at most SIGNUP_RATE_LIMIT_MAX accounts per IP address
# per SIGNUP_RATE_LIMIT_WINDOW_MINUTES (defaults: 5 per 60 minutes)
SIGNUP_RATE_LIMIT_MAX=
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=

# Number of reverse proxies in front of the dashboard that append to
# X-Forwarded-For (default 1). Used to find the client IP for rate limiting.
TRUSTED_PROXY_HOPS=
