datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// user, session, account, verification and rateLimit are the better auth
// models (see auth.js). the password hash lives on the credential account.
model User {
  id               String     @id @default(cuid())
  // better auth's display name; kept equal to username
  name             String
  username         String     @unique
  // accounts without an email get a placeholder (app/_lib/placeholderEmail.js)
  email            String     @unique
  emailVerified    Boolean    @default(false)
  image            String?
  // new address waiting for confirmation, while the current one stays in use
  pendingEmail     String?
  // email alerts about bot problems; only sent when the user has an email
  notifyBotIssues  Boolean    @default(true)
  // second factor at password login: totp (TwoFactor.verified) and/or email
  // codes. better auth sets twoFactorEnabled; emailOtpEnabled is ours, as
  // better auth can't turn email codes on per user (see app/_lib/mfa.js)
  twoFactorEnabled Boolean    @default(false)
  emailOtpEnabled  Boolean    @default(false)
  accounts         Account[]
  sessions         Session[]
  twoFactor        TwoFactor?
  passkeys         Passkey[]
  bots             Bot[]
  consent_agree    Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// totp secret and backup codes, both encrypted with the auth secret. a row
// with verified false holds backup codes for email-code-only users.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// reset-password tokens, and resend throttles (app/_lib/mailThrottle.js)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Bot {
  id                     String     @id @default(cuid())
  botType                String
  botName                String
  bitpartId              String     @unique
  phone                  String?
  countryCode            String
  name                   String
  description            String?
  about                  String?
  adminPhones            String[]
  passcode               String
  safetyTips             String?
  privacyPolicy          String?
  faq                    Json[]
  activationInstructions String?
  helpInstructions       String?
  locations              Json[]
  maxCodes               Int?
  plans                  Json[]
  referral               String?
  responseTime           String?
  storageAccess          String?
  problems               Json[]
  vpnName                String?
  instance               String
  qrLink                 String
  expireTimer            Int        @default(0)
  // last signal link and send status seen by the alert poller
  lastLinkStatus         String?
  lastSendStatus         String?
  // captcha token from bitpart while a challenge is outstanding
  challengeToken         String?
  alerts                 BotAlert[]
  creatorId              String
  creator                User       @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// successful sign-ups, for per-IP rate limiting. stores an HMAC of the IP,
// never the address itself.
model SignupAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// when each kind of alert was last emailed for a bot, for the cooldown
model BotAlert {
  id         Int      @id @default(autoincrement())
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind       String
  lastSentAt DateTime

  @@unique([botId, kind])
}

// which dashboard instance currently runs the bot alert poller. the holder
// renews it while polling; a lease past expiresAt can be taken over, so a
// crashed instance doesn't stop polling for good.
model PollerLease {
  name      String   @id
  holder    String
  expiresAt DateTime
}

model State {
  id           Int     @id @default(autoincrement())
  name         String  @unique @default("default")
  lastInstance String?
}
