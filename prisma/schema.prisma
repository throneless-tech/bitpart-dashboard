datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  email           String?   @unique
  emailVerified   DateTime?
  pendingEmail    String?
  password        String
  // bumped on password change/reset to sign out existing sessions
  sessionVersion  Int       @default(0)
  // email alerts about bot problems; only sent when the user has an email
  notifyBotIssues Boolean   @default(true)
  accounts        Account[]
  sessions        Session[]
  bots            Bot[]
  consent_agree   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Bot {
  id                     String     @id @default(cuid())
  botType                String
  botName                String
  bitpartId              String     @unique
  phone                  String?
  countryCode            String
  name                   String
  description            String?
  about                  String?
  adminPhones            String[]
  passcode               String
  safetyTips             String?
  privacyPolicy          String?
  faq                    Json[]
  activationInstructions String?
  helpInstructions       String?
  locations              Json[]
  maxCodes               Int?
  plans                  Json[]
  referral               String?
  responseTime           String?
  storageAccess          String?
  problems               Json[]
  vpnName                String?
  instance               String
  qrLink                 String
  expireTimer            Int        @default(0)
  // last signal link and send status seen by the alert poller
  lastLinkStatus         String?
  lastSendStatus         String?
  // captcha token from bitpart while a challenge is outstanding
  challengeToken         String?
  alerts                 BotAlert[]
  creatorId              String
  creator                User       @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// successful sign-ups, for per-IP rate limiting. stores an HMAC of the IP,
// never the address itself.
model SignupAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// when each kind of alert was last emailed for a bot, for the cooldown
model BotAlert {
  id         Int      @id @default(autoincrement())
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind       String
  lastSentAt DateTime

  @@unique([botId, kind])
}

// which dashboard instance currently runs the bot alert poller. the holder
// renews it while polling; a lease past expiresAt can be taken over, so a
// crashed instance doesn't stop polling for good.
model PollerLease {
  name      String   @id
  holder    String
  expiresAt DateTime
}

model State {
  id           Int     @id @default(autoincrement())
  name         String  @unique @default("default")
  lastInstance String?
}
