const { PrismaClient } = require('@prisma/client')
const prisma = new PrismaClient()

async function main() {
  const state = await prisma.state.upsert({
    where: { name: "default" },
    create: {
      name: "default",
      lastInstance: "default"
    },
    update: { lastInstance: "default" },
  })
}
main()
  .then(async () => {
    await prisma.$disconnect()
  })
  .catch(async (e) => {
    console.error(e)
    await prisma.$disconnect()
    process.exit(1)
  })
